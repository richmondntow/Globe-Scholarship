# Netlify supplies NETLIFY_DB_URL when it provisions Netlify Database.
# Set BETTER_AUTH_SECRET in the Netlify environment-variable dashboard (32+ random characters).
# Never commit real values. URL is supplied automatically by Netlify.
BETTER_AUTH_SECRET=
# Web discovery: set as a Netlify Functions secret, never NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-5-mini
# Local development only:
# BETTER_AUTH_ALLOW_LOCAL=true
# BETTER_AUTH_URL=http://127.0.0.1:5173
# NETLIFY_DB_URL=postgresql://...
